{
    "name": "tueen/database",
    "description": "The zero-config, high-throughput relational database engine engineered for Telegram bots and the Tueen ecosystem.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Tueen Ecosystem Team",
            "homepage": "https://tueen.dev"
        }
    ],
    "keywords": [
        "telegram",
        "bot",
        "database",
        "doctrine",
        "orm",
        "dbal",
        "migrations",
        "zero-config",
        "php84",
        "tueen"
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/dotenv": "^7.0 || ^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0",
        "symfony/password-hasher": "^7.0 || ^8.0",
        "symfony/security-core": "^7.0 || ^8.0",
        "symfony/serializer": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0",
        "symfony/validator": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tueen\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tueen\\Database\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/tueen-db"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "rector:check": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

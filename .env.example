# Database Driver: pdo_sqlite, pdo_mysql, or pdo_pgsql
DB_DRIVER=pdo_sqlite

# SQLite Configuration (Used when DB_DRIVER=pdo_sqlite)
DB_PATH=var/database.sqlite

# MySQL / PostgreSQL Configuration (Used when DB_DRIVER=pdo_mysql or pdo_pgsql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tueen_bot
DB_USER=root
DB_PASSWORD=secret

# Engine Settings
DB_AUTO_MIGRATE=true
DB_DEV_MODE=false
DEFAULT_CURRENCY=XTR
